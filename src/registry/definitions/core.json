        { "id": "out_max", "name": "out_max", "type": "number", "label": "Выход Макс", "defaultValue": 100 }
      ],
      "codeTemplate": {
        "section": "flow",
        "template": "{{output.result}} = int(({{inputs.val || props.default_val}} - {{props.in_min}}) * ({{props.out_max}} - {{props.out_min}}) / ({{props.in_max}} - {{props.in_min}}) + {{props.out_min}})",
        "outputVariables": {
          "result": "map_{{id}}"
        }
      }
