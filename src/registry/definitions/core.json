      "id": "core:map_range",
      "libraryId": "core",
      "label": "Map Range (Масштабирование)",
      "category": "Core",
      "color": "#3B82F6",
      "icon": "Minimize2",
      "description": "Линейное масштабирование значения из одного диапазона в другой (например, АЦП 0..1023 в ШИМ 0..1023 или угол 0..180)",
      "inputs": [
        { "id": "val", "name": "val", "type": "number", "label": "Value" }
      ],
      "outputs": [
        { "id": "result", "name": "result", "type": "number", "label": "Mapped Value" }
      ],
      "properties": [
        { "id": "in_min", "name": "in_min", "type": "number", "label": "Входной минимум (In Min)", "defaultValue": 0 },
        { "id": "in_max", "name": "in_max", "type": "number", "label": "Входной максимум (In Max)", "defaultValue": 1023 },
        { "id": "out_min", "name": "out_min", "type": "number", "label": "Выходной минимум (Out Min)", "defaultValue": 0 },
        { "id": "out_max", "name": "out_max", "type": "number", "label": "Выходной максимум (Out Max)", "defaultValue": 1023 },
        { "id": "as_int", "name": "as_int", "type": "boolean", "label": "Округлить до целого (int)", "defaultValue": true }
      ],
      "codeTemplate": {
        "section": "flow",
        "template": "{% if props.as_int %}{{output.result}} = int(({{inputs.val || 0}} - {{props.in_min}}) * ({{props.out_max}} - {{props.out_min}}) / (({{props.in_max}} - {{props.in_min}}) or 1) + {{props.out_min}}){% else %}{{output.result}} = float(({{inputs.val || 0}} - {{props.in_min}}) * ({{props.out_max}} - {{props.out_min}}) / (({{props.in_max}} - {{props.in_min}}) or 1) + {{props.out_min}}){% endif %}",
        "outputVariables": {
          "result": "map_{{id}}"
        }
      }
    },
