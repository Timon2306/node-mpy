  "nodes": [
    {
      "id": "network:wlan_connect",
      "libraryId": "network",
      "label": "WLAN Connect",
      "category": "Network",
      "color": "#06B6D4",
      "icon": "Wifi",
      "description": "Подключение контроллера к домашней Wi-Fi сети в режиме Station",
      "inputs": [
        {
          "id": "flow_in",
          "name": "flow_in",
          "type": "flow",
          "label": "Flow"
        }
      ],
      "outputs": [
        {
          "id": "flow_out",
          "name": "flow_out",
          "type": "flow",
          "label": "Flow"
        },
        {
          "id": "wlan_obj",
          "name": "wlan_obj",
          "type": "device",
          "label": "WLAN"
        }
      ],
      "properties": [
        {
          "id": "ssid",
          "name": "ssid",
          "type": "text",
          "label": "Имя сети (SSID)",
          "defaultValue": "MyWiFi"
        },
        {
          "id": "password",
          "name": "password",
          "type": "text",
          "label": "Пароль сети",
          "defaultValue": "12345678"
        }
      ],
      "codeTemplate": {
        "section": "flow",
        "imports": ["import time"],
        "template": "{{output.wlan_obj}} = network.WLAN(network.STA_IF)\n{{output.wlan_obj}}.active(True)\n{{output.wlan_obj}}.connect('{{props.ssid}}', '{{props.password}}')\nfor _ in range(200):\n    if {{output.wlan_obj}}.isconnected():\n        break\n    time.sleep_ms(100)",
        "outputVariables": {
          "wlan_obj": "wlan_{{id}}"
        }
      }
    },
