    {
      "id": "network:http_post",
      "libraryId": "network",
      "label": "HTTP POST Request",
      "category": "Network",
      "color": "#06B6D4",
      "icon": "Radio",
      "description": "Отправка показаний датчиков (АЦП) на сервер с получением ответа",
      "inputs": [
        {
          "id": "flow_in",
          "name": "flow_in",
          "type": "flow",
          "label": "Flow"
        },
        {
          "id": "url",
          "name": "url",
          "type": "string",
          "label": "URL (если провод)"
        },
        {
          "id": "data",
          "name": "data",
          "type": "any",
          "label": "Data / Sensor Val"
        }
      ],
      "outputs": [
        {
          "id": "flow_out",
          "name": "flow_out",
          "type": "flow",
          "label": "Flow"
        },
        {
          "id": "response",
          "name": "response",
          "type": "string",
          "label": "Response Text"
        },
        {
          "id": "status_code",
          "name": "status_code",
          "type": "number",
          "label": "Status Code"
        }
      ],
      "properties": [
        {
          "id": "url",
          "name": "url",
          "type": "text",
          "label": "URL сервера",
          "defaultValue": "http://192.168.1.100:1880/sensor"
        },
        {
          "id": "payload_format",
          "name": "payload_format",
          "type": "select",
          "label": "Формат отправки",
          "defaultValue": "text",
          "options": [
            {
              "label": "Plain Text / Number (Сырой текст/число)",
              "value": "text"
            },
            {
              "label": "JSON Объект ({\"value\": ...})",
              "value": "json"
            }
          ]
        },
        {
          "id": "json_key",
          "name": "json_key",
          "type": "text",
          "label": "Ключ JSON (для формата JSON)",
          "defaultValue": "value"
        },
        {
          "id": "timeout",
          "name": "timeout",
          "type": "number",
          "label": "Таймаут (сек)",
          "defaultValue": 5
        }
      ],
      "codeTemplate": {
        "section": "flow",
        "template": "try:\n    _res_{{id}} = urequests.post({{inputs.url || '{{props.url}}'}}, data=str({{inputs.data || 0}}), timeout={{props.timeout}})\n    {{output.response}} = _res_{{id}}.text\n    {{output.status_code}} = _res_{{id}}.status_code\n    _res_{{id}}.close()\nexcept Exception as _e_{{id}}:\n    {{output.response}} = \"\"\n    {{output.status_code}} = -1",
        "outputVariables": {
          "response": "post_res_{{id}}",
          "status_code": "post_code_{{id}}"
        }
      }
    },
    {
      "id": "network:http_get",
      "libraryId": "network",
      "label": "HTTP GET Request",
      "category": "Network",
      "color": "#06B6D4",
      "icon": "DownloadCloud",
      "description": "Выполнение HTTP GET запроса для получения данных (погода, REST API, облака IoT)",
      "inputs": [
        {
          "id": "flow_in",
          "name": "flow_in",
          "type": "flow",
          "label": "Flow"
        },
        {
          "id": "url",
          "name": "url",
          "type": "string",
          "label": "URL (если провод)"
        }
      ],
      "outputs": [
        {
          "id": "flow_out",
          "name": "flow_out",
          "type": "flow",
          "label": "Flow"
        },
        {
          "id": "response",
          "name": "response",
          "type": "string",
          "label": "Response Text"
        },
        {
          "id": "status_code",
          "name": "status_code",
          "type": "number",
          "label": "Status Code"
        }
      ],
      "properties": [
        {
          "id": "url",
          "name": "url",
          "type": "text",
          "label": "URL запроса",
          "defaultValue": "http://api.weatherbit.io/v2.0/current?city=Moscow,RU&key=YOUR_KEY"
        },
        {
          "id": "timeout",
          "name": "timeout",
          "type": "number",
          "label": "Таймаут (сек)",
          "defaultValue": 10
        }
      ],
      "codeTemplate": {
        "section": "flow",
        "template": "try:\n    import urequests as _rq_{{id}}\n    _res_{{id}} = _rq_{{id}}.get({{inputs.url || ('\"' + props.url + '\"')}})\n    {{output.response}} = _res_{{id}}.text\n    {{output.status_code}} = _res_{{id}}.status_code\n    _res_{{id}}.close()\nexcept Exception:\n    try:\n        import socket\n        _, _, _host_{{id}}, _path_{{id}} = ({{inputs.url || ('\"' + props.url + '\"')}}).split('/', 3)\n        _addr_{{id}} = socket.getaddrinfo(_host_{{id}}, 80)[0][-1]\n        _s_{{id}} = socket.socket()\n        _s_{{id}}.connect(_addr_{{id}})\n        _s_{{id}}.send(bytes('GET /%s HTTP/1.0\\r\\nHost: %s\\r\\n\\r\\n' % (_path_{{id}}, _host_{{id}}), 'utf8'))\n        _raw_{{id}} = ''\n        while True:\n            _chunk_{{id}} = _s_{{id}}.recv(256)\n            if _chunk_{{id}}:\n                _raw_{{id}} += str(_chunk_{{id}}, 'utf8')\n            else:\n                break\n        _s_{{id}}.close()\n        {{output.response}} = _raw_{{id}}.split('\\r\\n\\r\\n', 1)[1] if '\\r\\n\\r\\n' in _raw_{{id}} else _raw_{{id}}\n        {{output.status_code}} = 200\n    except Exception as _err_{{id}}:\n        {{output.response}} = ''\n        {{output.status_code}} = -1",
        "outputVariables": {
          "response": "get_res_{{id}}",
          "status_code": "get_code_{{id}}"
        }
      }
    },
    {
      "id": "network:dashboard_client",
      "libraryId": "network",
      "label": "Отправка в Дашборд",
      "category": "Network",
      "color": "#06B6D4",
      "icon": "Radio",
      "description": "Отправляет показания датчиков на сервер дашборда (порт 1880) и получает команды от кнопок, тумблеров и ползунков",
      "inputs": [
        {
          "id": "flow_in",
          "name": "flow_in",
          "type": "flow",
          "label": "Flow"
        },
        {
          "id": "value",
          "name": "value",
          "type": "any",
          "label": "Датчик 1 (Свет/Темп)"
        },
        {
          "id": "val2",
          "name": "val2",
          "type": "any",
          "label": "Датчик 2 (опц.)"
        }
      ],
      "outputs": [
        {
          "id": "flow_out",
          "name": "flow_out",
          "type": "flow",
          "label": "Flow"
        },
        {
          "id": "command",
          "name": "command",
          "type": "string",
          "label": "Команды"
        },
        {
          "id": "slider_val",
          "name": "slider_val",
          "type": "number",
          "label": "Число ползунка"
        },
        {
          "id": "is_on",
          "name": "is_on",
          "type": "boolean",
          "label": "Есть ON?"
        },
        {
          "id": "response",
          "name": "response",
          "type": "string",
          "label": "Ответ сервера"
        },
        {
          "id": "status_code",
          "name": "status_code",
          "type": "number",
          "label": "Status"
        }
      ],
      "properties": [
        {
          "id": "server_ip",
          "name": "server_ip",
          "type": "text",
          "label": "IP компьютера (пусто — определится сам)",
          "defaultValue": ""
        },
        {
          "id": "server_port",
          "name": "server_port",
          "type": "number",
          "label": "Порт сервера",
          "defaultValue": 1880
        },
        {
          "id": "path",
          "name": "path",
          "type": "text",
          "label": "Имя показаний (как в дашборде)",
          "defaultValue": "/light"
        },
        {
          "id": "param",
          "name": "param",
          "type": "text",
          "label": "Параметр 1",
          "defaultValue": "value"
        },
        {
          "id": "param2",
          "name": "param2",
          "type": "text",
          "label": "Параметр 2",
          "defaultValue": "val2"
        }
      ],
      "codeTemplate": {
        "section": "flow",
        "template": "{{output.command}}, {{output.slider_val}}, {{output.is_on}}, {{output.response}}, {{output.status_code}} = dashboard_sync(\n    '{{props.server_ip}}', {{props.server_port}}, '{{props.path}}',\n    '{{props.param}}', {{inputs.value || 0}}, '{{props.param2}}', {{inputs.val2 || None}})",
        "outputVariables": {
          "command": "dash_cmd_{{id}}",
          "slider_val": "dash_slider_{{id}}",
          "is_on": "dash_on_{{id}}",
          "response": "dash_res_{{id}}",
          "status_code": "dash_code_{{id}}"
        },
        "helpers": [
          "def dashboard_sync(host, port, path, param1, value1, param2, value2):\n    try:\n        import socket\n        import json\n        if not path.startswith('/'):\n            path = '/' + path\n        query = path + '?' + param1 + '=' + str(value1)\n        if value2 is not None:\n            query += '&' + param2 + '=' + str(value2)\n        s = socket.socket()\n        try:\n            s.settimeout(2)\n            s.connect((host, port))\n            s.send(('GET ' + query + ' HTTP/1.0\\r\\nHost: ' + host + '\\r\\n\\r\\n').encode())\n            raw = b''\n            while len(raw) < 1024:\n                chunk = s.recv(256)\n                if not chunk:\n                    break\n                raw += chunk\n        finally:\n            s.close()\n        parts = raw.split(b'\\r\\n\\r\\n', 1)\n        code = int(parts[0].split()[1])\n        body = parts[-1].decode().strip()\n        try:\n            reply = json.loads(body)\n        except ValueError:\n            reply = body\n        number = 0\n        is_on = False\n        for v in (reply.values() if isinstance(reply, dict) else [reply]):\n            if v is True or v == '1' or str(v).endswith('ON'):\n                is_on = True\n            elif isinstance(v, (int, float)) and v is not False:\n                number = v\n        return reply, number, is_on, body, code\n    except Exception:\n        return '', 0, False, '', -1\n"
        ]
      }
    },
    {
      "id": "network:dashboard_command",
      "libraryId": "network",
      "label": "Проверка команды",
      "category": "Network",
      "color": "#06B6D4",
      "icon": "CheckSquare",
      "description": "Проверяет, есть ли заданная команда среди текущих команд дашборда (например FAN_ON, MOTOR_START, DOOR_OPEN)",
      "inputs": [
        {
          "id": "command",
          "name": "command",
          "type": "string",
          "label": "Команда"
        }
      ],
      "outputs": [
        {
          "id": "is_match",
          "name": "is_match",
          "type": "boolean",
          "label": "Совпало?"
        }
      ],
      "properties": [
        {
          "id": "target_cmd",
          "name": "target_cmd",
          "type": "text",
          "label": "Ожидаемая команда",
          "defaultValue": "CMD_ON"
        }
      ],
      "codeTemplate": {
        "section": "flow",
        "template": "{{output.is_match}} = ('{{props.target_cmd}}' in {{inputs.command || ''}}.values()) if isinstance({{inputs.command || ''}}, dict) else (str({{inputs.command || ''}}).strip() == '{{props.target_cmd}}')",
        "outputVariables": {
          "is_match": "cmd_match_{{id}}"
        }
      }
    },
    {
      "id": "network:dashboard_value",
      "libraryId": "network",
      "label": "Значение канала",
      "category": "Network",
      "color": "#06B6D4",
      "icon": "Sliders",
      "description": "Читает значение одного тумблера или ползунка дашборда по имени его канала (например pwm или relay)",
      "inputs": [
        {
          "id": "command",
          "name": "command",
          "type": "string",
          "label": "Команды"
        }
      ],
      "outputs": [
        {
          "id": "value",
          "name": "value",
          "type": "any",
          "label": "Значение"
        }
      ],
      "properties": [
        {
          "id": "channel",
          "name": "channel",
          "type": "text",
          "label": "Имя канала",
          "defaultValue": "slider1"
        },
        {
          "id": "default_val",
          "name": "default_val",
          "type": "number",
          "label": "Значение, если канала нет",
          "defaultValue": 0
        }
      ],
      "codeTemplate": {
        "section": "flow",
        "template": "{{output.value}} = {{inputs.command || ''}}.get('{{props.channel}}', {{props.default_val}}) if isinstance({{inputs.command || ''}}, dict) else {{props.default_val}}",
        "outputVariables": {
          "value": "channel_{{id}}"
        }
      }
    }
  ]
}
